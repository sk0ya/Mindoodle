{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "./dist",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // Entrypoint must match wrangler.toml's compatibility_date (2024-10-01).
    // The package default targets a compatibility date before 2021-11-03 and
    // predates R2ListOptions.include; "2023-07-01" covers everything after it.
    "types": ["@cloudflare/workers-types/2023-07-01"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}